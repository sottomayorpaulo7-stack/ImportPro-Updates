@echo off
chcp 65001 >nul
title Instalar ImportPro
set "DEST=%LOCALAPPDATA%\ImportaConsole"
echo.
echo  ==========================================
echo    ImportPro - instalacao
echo  ==========================================
echo.

call :procurar_python
if not defined PY (
  echo  O Python nao esta instalado. A instalar agora, demora 1 a 3 minutos...
  echo  Se o Windows pedir autorizacao, carregue em Sim.
  echo.
  winget install -e --id Python.Python.3.12 --scope user --silent --accept-package-agreements --accept-source-agreements
  call :procurar_python
)
if not defined PY (
  echo.
  echo  Nao consegui instalar o Python automaticamente. Faca assim:
  echo  1. Na pagina que se vai abrir, carregue em "Download Python".
  echo  2. Abra o ficheiro descarregado, marque "Add python.exe to PATH" e carregue em "Install Now".
  echo  3. No fim, volte a abrir este instalador.
  echo.
  start https://www.python.org/downloads/
  pause
  exit /b 1
)
set "PYEXE="
for /f "delims=" %%P in ('call %PY% -c "import sys;print(sys.executable)"') do set "PYEXE=%%P"
if not defined PYEXE goto erro

echo  A fechar a versao antiga, se estiver aberta...
powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*ImportaConsole*servidor.py*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"
timeout /t 1 >nul
echo  A copiar o programa para %DEST% ...
if not exist "%DEST%" mkdir "%DEST%"
set "INST=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';$t=[IO.File]::ReadAllText($env:INST);$m='#'+'#PACOTE#'+'#';$i=$t.LastIndexOf($m);$b=[Convert]::FromBase64String(($t.Substring($i+$m.Length) -replace '[^A-Za-z0-9+/=]',''));$z=Join-Path $env:TEMP 'importa-console.zip';[IO.File]::WriteAllBytes($z,$b);Expand-Archive -LiteralPath $z -DestinationPath $env:DEST -Force;Remove-Item $z"
if errorlevel 1 goto erro
powershell -NoProfile -ExecutionPolicy Bypass -File "%DEST%\instalar.ps1"
if errorlevel 1 goto erro

echo.
echo  Pronto! Tem agora o icone "ImportPro" no ambiente de trabalho.
echo  A abrir o programa...
start "" "%WINDIR%\System32\wscript.exe" "%DEST%\abrir.vbs"
timeout /t 4 >nul
exit /b 0

:erro
echo.
echo  Algo correu mal. Tire uma fotografia a esta janela e envie-a.
pause
exit /b 1

:procurar_python
set PY=
if exist "%LOCALAPPDATA%\Programs\Python\Launcher\py.exe" set PY="%LOCALAPPDATA%\Programs\Python\Launcher\py.exe" -3
if not defined PY if exist "%WINDIR%\py.exe" set PY="%WINDIR%\py.exe" -3
if not defined PY for /d %%D in ("%LOCALAPPDATA%\Programs\Python\Python3*") do if exist "%%D\python.exe" set PY="%%D\python.exe"
if not defined PY for /d %%D in ("%ProgramFiles%\Python3*") do if exist "%%D\python.exe" set PY="%%D\python.exe"
if not defined PY python --version >nul 2>nul && set PY=python
goto :eof
